{
  "manifest_version": 3,
  "name": "Shizuo",
  "short_name": "Shizuo",
  "version": "2.24.5",
  "minimum_chrome_version": "116",
  "description": "Collect web research, ask AI about it, and keep answers beside their sources for follow-up questions.",
  "author": "拾作 Contributors",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "offscreen", "contextMenus", "sidePanel", "nativeMessaging", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Shizuo — Ask AI with your sources",
    "default_popup": "app/pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "app/pages/whiteboard/index.html"
  },
  "side_panel": {
    "default_path": "app/pages/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "app/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["app/core/i18n-en.js", "app/core/i18n-en-extended.js", "app/core/i18n.js", "app/content/content-codex.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/monaco/min/*", "vendor/turndown/*", "vendor/readability/*", "vendor/markdown/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  }
}
