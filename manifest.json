{
  "manifest_version": 3,
  "name": "拾作",
  "short_name": "拾作",
  "version": "2.24.5",
  "minimum_chrome_version": "116",
  "description": "收集网页资料，交给 Codex 总结和对比。材料与回答保存在一起，方便核查来源、继续追问。",
  "author": "拾作 Contributors",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "offscreen", "contextMenus", "sidePanel", "nativeMessaging", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "拾作 — 带着资料问 AI",
    "default_popup": "app/pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "app/pages/whiteboard/index.html"
  },
  "side_panel": {
    "default_path": "app/pages/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "app/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["app/content/content-codex.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/monaco/min/*", "vendor/turndown/*", "vendor/readability/*", "vendor/markdown/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  }
}
